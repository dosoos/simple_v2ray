# Caddy 站点名与 TLS 证书域名
HOST_DOMAIN=localhost

# Caddy Basic Auth（保护 /panel 与 /api/panel）
# 用户名
CADDY_ADMIN_USER=admin
# 密码的 bcrypt 哈希（不要用明文）。生成方式：
#   ./scripts/gen-caddy-hash.sh '你的强密码'
# 或：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的强密码'
# 将输出的哈希粘贴在下一行。留空时 compose 内建默认（密码为 changeme，仅用于试跑）
CADDY_ADMIN_HASH=
