(vpc_handlers) {

    @v2ws {
        # 兼容 Upgrade/upgrade 等大小写差异；VMess WS 路径与 config.json 中 wsSettings.path 一致
        path /api
        header Connection *pgrade*
        header Upgrade *ebsocket*
    }
    reverse_proxy @v2ws v2ray:58888

    # 管理入口统一走 /panel（含 /panel/api/*），静态资源 /assets/*。勿仅用 path /panel*：部分 Caddy 版本不匹配 /panel/，会得到空响应（Content-Length: 0）
    @panel {
        path_regexp panel_route ^/panel(/.*)?$$|^/assets/
    }
    handle @panel {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        reverse_proxy panel:8000
    }

    log {
        format console
    }
}

http://localhost http://127.0.0.1 {
    import vpc_handlers
}

# 站点列表来自环境变量 HOST_DOMAIN_SITES（由 compose 启动脚本把 HOST_DOMAIN 规范为「逗号后必须有空格」）
{$HOST_DOMAIN_SITES} {
    import vpc_handlers
}
