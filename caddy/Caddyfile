(vpc_handlers) {

    @v2ws {
        # 兼容 Upgrade/upgrade 等大小写差异
        path /proxy
        header Connection *pgrade*
        header Upgrade *ebsocket*
    }
    reverse_proxy @v2ws v2ray:58888

    # 面板、API 与 Sneat 静态资源（/assets/*）。勿仅用 path /panel*：部分 Caddy 版本不匹配 /panel/，会得到空响应（Content-Length: 0）
    @panel {
        path_regexp panel_route ^/(panel|api/panel)(/.*)?$$|^/assets/
    }
    handle @panel {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        reverse_proxy panel:8000
    }

    log {
        format console
    }
}

http://localhost http://127.0.0.1 {
    import vpc_handlers
}

{$HOST_DOMAIN} {
    import vpc_handlers
}
