(vpc_handlers) {

    @v2ws {
        # 兼容 Upgrade/upgrade 等大小写差异
        path /proxy
        header Connection *pgrade*
        header Upgrade *ebsocket*
    }
    reverse_proxy @v2ws v2ray:58888

    # 管理面板与 API：由 Caddy Basic Auth 保护，反代到 FastAPI
    @panel {
        path /panel*
        path /api/panel*
    }
    handle @panel {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        reverse_proxy panel:8000
    }

    handle {
        respond "VPC proxy" 200
    }

    log {
        format console
    }
}

http://localhost http://127.0.0.1 {
    import vpc_handlers
}

{$HOST_DOMAIN} {
    import vpc_handlers
}
