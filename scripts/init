#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"

usage() {
  cat <<EOF
用法: $0 [-d domain1,domain2,...] [-p adminpass]

  -d  站点域名，逗号分隔（例: example.com,www.example.com）
  -p  管理页 Basic Auth 密码

不带参数时进入交互式配置，完成后写入 .env 与 caddy/Caddyfile。
EOF
}

DOMAINS=""
PASSWORD=""
ADMIN_USER="admin"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d)
      [[ $# -ge 2 ]] || { echo "错误: -d 需要域名参数" >&2; exit 1; }
      DOMAINS="$2"
      shift 2
      ;;
    -p)
      [[ $# -ge 2 ]] || { echo "错误: -p 需要密码参数" >&2; exit 1; }
      PASSWORD="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "未知参数: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$DOMAINS" ]]; then
  prompt_domains
else
  DOMAINS="$(normalize_domains_csv "$DOMAINS")"
fi

if [[ -z "$PASSWORD" ]]; then
  prompt_password
fi

write_env "$DOMAINS" "$ADMIN_USER"
write_caddyfile "$DOMAINS" "$ADMIN_USER" "$PASSWORD"
print_overview "$DOMAINS" "$ADMIN_USER" "$PASSWORD"
