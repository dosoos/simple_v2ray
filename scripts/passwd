#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"

usage() {
  cat <<EOF
用法: $0 [-p adminpass]

  -p  新的管理页 Basic Auth 密码

不带参数时进入交互式输入，完成后更新 caddy/Caddyfile（域名从 .env 读取）。
EOF
}

PASSWORD=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p)
      [[ $# -ge 2 ]] || { echo "错误: -p 需要密码参数" >&2; exit 1; }
      PASSWORD="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "未知参数: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f "$ENV_FILE" ]]; then
  echo "错误: 未找到 ${ENV_FILE}，请先运行 ./scripts/init" >&2
  exit 1
fi

DOMAINS="$(read_env_value HOST_DOMAIN || true)"
ADMIN_USER="$(read_env_value CADDY_ADMIN_USER || true)"
ADMIN_USER="${ADMIN_USER:-admin}"

if [[ -z "$DOMAINS" ]]; then
  echo "错误: .env 中缺少 HOST_DOMAIN，请先运行 ./scripts/init" >&2
  exit 1
fi

if [[ -z "$PASSWORD" ]]; then
  prompt_password
fi

write_caddyfile "$DOMAINS" "$ADMIN_USER" "$PASSWORD"
print_overview "$DOMAINS" "$ADMIN_USER" "$PASSWORD"
